DATABASE_PATH=./llm_chat_web_ui.sqlite3
SESSION_TTL_SECONDS=28800

# Phase 1 device access controls.
ENFORCE_DEVICE_WHITELIST=false
TRUST_PROXY_HEADERS=false
CLIENT_CERT_FINGERPRINT_HEADER=x-client-cert-fingerprint

# Add http://SERVER_IP:5173 here if browsers call the backend directly from
# another Windows/Linux machine. Same-origin reverse proxy or Vite proxy does
# not need extra CORS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development uses mock mode until a real LLM endpoint exists.
LLM_MOCK=true

# mock, openai, anthropic, or gemini. LLM_MOCK=true always forces mock mode.
LLM_PROVIDER=mock

# OpenAI-compatible temporary provider. This can point to OpenAI, an internal
# OpenAI-compatible gateway, or a future closed-network LLM endpoint.
LLM_API_BASE=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=local-model

# Anthropic Claude temporary provider.
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-model

# Google Gemini temporary provider.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
